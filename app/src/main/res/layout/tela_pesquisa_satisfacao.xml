<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pesquisa de satisfação"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1F3864" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Etapa 2 de 3"
        android:textSize="14sp"
        android:textColor="#757575" />

    <ProgressBar
        android:id="@+id/prgEtapa"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:max="3"
        android:progress="3" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:background="#E0E0E0" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Como você avalia o atendimento?"
        android:textSize="16sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/grpNota"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rdbOtimo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ótimo" />

        <RadioButton
            android:id="@+id/rdbBom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bom" />

        <RadioButton
            android:id="@+id/rdbRegular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Regular" />

        <RadioButton
            android:id="@+id/rdbRuim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ruim" />

    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="O que podemos melhorar?"
        android:textSize="16sp"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/chkRapidez"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rapidez no atendimento" />

    <CheckBox
        android:id="@+id/chkPreco"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Preço" />

    <CheckBox
        android:id="@+id/chkVariedade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Variedade de opções" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Voltaria a usar o serviço?"
        android:textSize="16sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/grpVoltaria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rdbSim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sim" />

        <RadioButton
            android:id="@+id/rdbNao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Não" />

    </RadioGroup>

    <EditText
        android:id="@+id/edtComentario"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="12dp"
        android:hint="Deixe um comentário (opcional)"
        android:inputType="textMultiLine"
        android:gravity="top" />

    <CheckBox
        android:id="@+id/chkResposta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Quero receber a resposta por e-mail" />

    <Button
        android:id="@+id/btnEnviar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Enviar resposta"
        android:textAllCaps="false"
        android:backgroundTint="#1F3864" />

</LinearLayout>
