<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ficha de inscrição"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1F3864" />
    <EditText
        android:id="@+id/edtNome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Nome completo"
        android:inputType="textPersonName" />
    <EditText
        android:id="@+id/edtTelefone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Telefone"
        android:inputType="phone" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Período desejado:"
        android:textStyle="bold" />
    <RadioGroup
        android:id="@+id/grpPeriodo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <RadioButton
            android:id="@+id/rdbManha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manhã" />
        <RadioButton
            android:id="@+id/rdbNoite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Noite" />
    </RadioGroup>
    <CheckBox
        android:id="@+id/chkTermos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Li e aceito o regulamento" />
    <Button
        android:id="@+id/btnInscrever"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Confirmar inscrição"
        android:textAllCaps="false"/>
</LinearLayout>